{
  "name": "@relay/android",
  "private": true,
  "type": "module",
  "scripts": {
    "web:build": "cd ../.. && npm run build:web",
    "sync": "npm run web:build && npx cap sync android",
    "build:debug": "npm run sync && node run-gradle.mjs :app:assembleDebug --no-daemon --max-workers=1 --console=plain",
    "test:local": "npm run sync && node run-gradle.mjs :app:testDebugUnitTest :app:assembleDebugAndroidTest --offline --no-daemon --max-workers=1 --console=plain",
    "install:debug": "node install-debug.mjs",
    "build:release": "npm run sync && npx cap build android --androidreleasetype AAB"
  }
}
