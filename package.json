{
  "name": "web-ssh-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/windows/electron-main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/concurrently/dist/bin/index.js -k \"vite --host 0.0.0.0\" \"tsx src/server/index.ts\"",
    "build:web": "vite build --outDir dist/web",
    "build:server": "tsup src/server/index.ts --format esm --target node22 --out-dir dist/server --sourcemap --clean --external ws",
    "build:cloud": "tsup src/cloud/index.ts --format esm --target node22 --out-dir dist/cloud --sourcemap --clean --external ws",
    "build:windows:main": "tsup --config apps/windows/tsup-main.config.ts",
    "build:windows:preload": "tsup --config apps/windows/tsup-preload.config.ts",
    "build:windows": "npm run build:web && npm run build:windows:main && npm run build:windows:preload",
    "dev:windows": "npm run build:windows && electron .",
    "package:windows": "npm run build:windows && electron-builder --win nsis --x64 --config.directories.output=dist/releases/nsis --publish never && electron-builder --win portable --x64 --config.directories.output=dist/releases/portable --publish never",
    "package:windows:portable": "npm run build:windows && electron-builder --win portable --x64 --config.npmRebuild=false --config.directories.output=dist/releases-portable-preview --config.compression=store --publish never",
    "build:android:debug": "npm --prefix apps/android run build:debug",
    "build:android:release": "npm --prefix apps/android run build:release",
    "build": "npm run build:web && npm run build:server && npm run build:cloud",
    "start": "node dist/server/index.js",
    "start:cloud": "node dist/cloud/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.4",
    "fflate": "^0.8.3",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "ssh2@1.17.0": true
  },
  "build": {
    "appId": "cn.ayan.relay",
    "productName": "Relay",
    "asar": true,
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "files": [
      "dist/web/**/*",
      "dist/windows/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/argon2/**/*",
      "node_modules/cpu-features/**/*",
      "node_modules/ssh2/**/*"
    ],
    "directories": {
      "output": "dist/releases"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Relay-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
